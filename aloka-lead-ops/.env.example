# Copy to .env at repository root. Never commit actual values.
DATABASE_URL=postgres://aloka:local-only-change-me@localhost:5432/aloka
PORT=4000
WEB_ORIGIN=http://localhost:3000
AUTH_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
AUTH_AUDIENCE=authenticated
AUTH_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:4000
# Separate random secrets, >=32 characters each; never public env vars
INTAKE_TOKEN=
AUTOMATION_TOKEN=
OPENWA_WEBHOOK_TOKEN=
MESSAGING_ENABLED=false
MESSAGING_PROVIDER=openwa
OPENWA_BASE_URL=https://YOUR_EXISTING_VPS_OPENWA
OPENWA_API_KEY=
OPENWA_SEND_PATH=/sendText
# Conservative operational settings; do not guarantee account safety
SEND_MIN_INTERVAL_SECONDS=120
SEND_DAILY_LIMIT=100
SEND_START_HOUR_IST=9
SEND_END_HOUR_IST=21
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_GRAPH_VERSION=
SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
N8N_ENCRYPTION_KEY=
POSTGRES_PASSWORD=local-only-change-me
